# =============================================================================
# Hermes runtime env — written to /opt/hermes-data/.env inside the container.
# Hermes reads this file at startup (not Docker env vars).
# =============================================================================

# Allow all users to interact with the gateway.
# For production, replace with platform-specific allowlists:
#   TELEGRAM_ALLOWED_USERS=your_telegram_id
#   DISCORD_ALLOWED_USERS=your_discord_id
GATEWAY_ALLOW_ALL_USERS=true
