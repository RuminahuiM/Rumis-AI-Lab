.env

# Let's Encrypt certificates (contain private keys – never commit)
certbot/conf/
certbot/www/

# nginx generated config and auth files
nginx/auth/

# Terraform state and local config
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfvars
terraform/.terraform.lock.hcl

# Packer output
packer/output-*/

# Backend environment (contains HF_TOKEN)
backend/.env
