# ── Anthropic API Key ──
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-PASTE-YOUR-KEY-HERE

# ── OpenAI API Key ──
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-PASTE-YOUR-KEY-HERE

# ── Google Gemini API Key ──
# https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE-YOUR-KEY-HERE

# ── Open WebUI Admin Account ──────────────────────────────────────────────────
# Pre-creates the admin account on first boot. Signup is auto-disabled after.
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=change-me-to-a-strong-password

# ── PostgreSQL (shared by Open WebUI + n8n) ──────────────────────────────────
POSTGRES_USER=rumis
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ── VLLM Backend (DGX Spark) ─────────────────────────────────────────────────
# OpenAI-compatible endpoint served by the backend VLLM instance.
VLLM_ENDPOINT=http://192.168.1.200:8000

# ── Synology NAS Storage (NFS) ───────────────────────────────────────────────
# Docker volumes mount NFS shares from this NAS for persistent data.
NAS_IP=192.168.1.50
NAS_SHARE_PATH=/volume1/rumis-ai-lab

# ── SSL / Domain Configuration (required for public HTTPS deployment) ─────────
# Subdomain that will serve Open WebUI  (e.g. oui.mydomain.ch)
OUI_DOMAIN=oui.mydomain.ch
# Subdomain that will serve n8n         (e.g. n8n.mydomain.ch)
N8N_DOMAIN=n8n.mydomain.ch
# Email used for Let's Encrypt expiry notifications
CERTBOT_EMAIL=you@example.com

# ── n8n License Key (optional — for self-hosted paid features) ───────────────
# Get yours at: https://n8n.io/pricing (Self-hosted plan)
N8N_LICENSE_KEY=

# ── Timezone (used by n8n for workflow scheduling) ───────────────────────────
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
GENERIC_TIMEZONE=Europe/Zurich

# ── LiteLLM Master Key ───────────────────────────────────────────────────────
# Protects the LiteLLM proxy API. Change this from the default.
LITELLM_MASTER_KEY=sk-change-me-to-a-strong-secret
