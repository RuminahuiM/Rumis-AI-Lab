# ── Anthropic API Key ──
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-PASTE-YOUR-KEY-HERE

# ── OpenAI API Key ──
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-PASTE-YOUR-KEY-HERE

# ── Google Gemini API Key ──
# https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE-YOUR-KEY-HERE

# ── Open WebUI Admin Account ──────────────────────────────────────────────────
# Pre-creates the admin account on first boot. Signup is auto-disabled after.
WEBUI_ADMIN_EMAIL=admin@example.com
WEBUI_ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Azure AD SSO (OpenWebUI — native OIDC) ───────────────────────────────────
# Create an App Registration in Azure AD for OpenWebUI.
# See docs/sso-setup.md for step-by-step instructions.
AZURE_TENANT_ID=your-azure-ad-tenant-id
OAUTH_CLIENT_ID=your-openwebui-app-registration-client-id
OAUTH_CLIENT_SECRET=your-openwebui-client-secret

# ── Azure AD SSO (n8n — via n8n-oidc community module) ───────────────────────
# Create a separate App Registration in Azure AD for n8n.
OAUTH_CLIENT_ID_N8N=your-n8n-app-registration-client-id
OAUTH_CLIENT_SECRET_N8N=your-n8n-client-secret

# ── VLLM Backend (DGX Spark) ─────────────────────────────────────────────────
# OpenAI-compatible endpoint served by the backend VLLM instance.
VLLM_ENDPOINT=http://192.168.1.200:8000

# ── n8n License Key (optional — for self-hosted community features) ──────────
# Register at: https://n8n.io/pricing (free Registered Community license)
N8N_LICENSE_KEY=

# ── Timezone (used by n8n for workflow scheduling) ───────────────────────────
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
GENERIC_TIMEZONE=Europe/Zurich

# ── LiteLLM Master Key ───────────────────────────────────────────────────────
# Protects the LiteLLM proxy API. Change this from the default.
LITELLM_MASTER_KEY=sk-change-me-to-a-strong-secret
