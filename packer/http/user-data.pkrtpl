#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: rumis-ai-lab
    username: rumis
    password: "${password_hash}"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: lvm
      sizing-policy: all
  packages:
    - open-vm-tools
    - cloud-init
    - git
    - ca-certificates
    - curl
  late-commands:
    - echo 'rumis ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/rumis
    - chmod 440 /target/etc/sudoers.d/rumis
