# ── HuggingFace Token (required for gated models like Gemma) ──────────────────
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_PASTE-YOUR-TOKEN-HERE

# ── Model Configuration ──────────────────────────────────────────────────────
# See models.yaml for tested configurations.
VLLM_MODEL=google/gemma-4-27b-it
VLLM_QUANTIZATION=nvfp4

# ── Tuning (defaults work well for DGX Spark) ────────────────────────────────
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_TENSOR_PARALLEL_SIZE=1
