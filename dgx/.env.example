# =============================================================================
# dgx/.env.example — Vorlage für die echte .env auf dem DGX Spark
# =============================================================================
# Die Variablennamen hier entsprechen EXAKT der real laufenden .env auf dem
# DGX Spark. Alle Werte sind Platzhalter.
#
#   Echte Datei mit den echten Werten:
#   auf dem DGX (spark-753b) in /home/adm-dgx/Rumis-AI-Lab/backend/.env
#
# Diese Datei ist gitignored (siehe .gitignore) und darf NIE committet werden.
#
# Verwendung bei einem Redeployment:
#   cp dgx/.env.example <ziel>/.env   und die Werte eintragen.
#
# Für die nicht-geheimen Variablen ist der aktuell live gesetzte Wert als
# Kommentar dokumentiert, damit ein Redeployment denselben Zustand erreicht.
# =============================================================================

# ── HuggingFace Token (required for gated models like Gemma) ──────────────────
# https://huggingface.co/settings/tokens
# GEHEIM — nur auf dem DGX in backend/.env vorhanden.
HF_TOKEN=<ECHTER-WERT-AUF-DGX>

# ── Model Configuration ──────────────────────────────────────────────────────
# See models.yaml for tested configurations.
# Live-Wert: google/gemma-4-26b-a4b-it
VLLM_MODEL=<ECHTER-WERT-AUF-DGX>
# Live-Wert: modelopt_fp4
# ACHTUNG: Diese Variable wird von docker-compose.yml NICHT ausgewertet.
# Der laufende Container hat kein --quantization Flag. Siehe DRIFT.md (D4).
VLLM_QUANTIZATION=<ECHTER-WERT-AUF-DGX>

# ── Tuning (defaults work well for DGX Spark) ────────────────────────────────
# Live-Wert: 8192
VLLM_MAX_MODEL_LEN=<ECHTER-WERT-AUF-DGX>
# Live-Wert: 0.90
VLLM_GPU_MEMORY_UTILIZATION=<ECHTER-WERT-AUF-DGX>
# Live-Wert: 1
VLLM_TENSOR_PARALLEL_SIZE=<ECHTER-WERT-AUF-DGX>
# Live-Wert: gemma-4-26b-a4b-it
# Wichtig: ohne "google/"-Prefix, sonst bricht LiteLLM (siehe DRIFT.md D8).
VLLM_SERVED_MODEL_NAME=<ECHTER-WERT-AUF-DGX>

# ── HuggingFace offline mode ─────────────────────────────────────────────────
# NICHT in der echten .env gesetzt. docker-compose.yml setzt den Default 0,
# der laufende Container hat entsprechend HF_HUB_OFFLINE=0.
# Auf 1 setzen, sobald das Modell einmal heruntergeladen wurde, um Internet-
# Zugriff beim Start zu vermeiden.
# HF_HUB_OFFLINE=<ECHTER-WERT-AUF-DGX>
